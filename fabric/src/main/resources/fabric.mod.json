{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_source}"
  },
  "license": "${mod_license}",
  "environment": "*",
  "mixins": [
    {
      "config": "tubularstorage-common.mixins.json",
      "environment": "*"
    }
  ],
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.tubularstorage.TubularStorageFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.tubularstorage.TubularStorageFabric"
      }
    ]
  },
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "archie": ">=${versions.archie}",
    "cloth-config": ">=${versions.cloth_config_range}"
  }
}
