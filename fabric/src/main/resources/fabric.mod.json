{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_source}",
    "issues": "${mod_issues}"
  },
  "custom": {
    "catalogue": {
      "banner": "assets/${mod_id}/banner.png"
    }
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "mixins": [
    {
      "config": "boilerplate-common.mixins.json",
      "environment": "*"
    }
  ],
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.boilerplate.BoilerplateFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.boilerplate.BoilerplateFabric"
      }
    ],
    "rei_client": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.boilerplate.compat.rei.BoilerplateREIPlugin"
      }
    ],
    "emi": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.boilerplate.compat.emi.BoilerplateEmiPlugin"
      }
    ],
    "jei_mod_plugin": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.boilerplate.compat.jei.BoilerplateJEIPlugin"
      }
    ]
  },
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "archie": ">=${versions.archie}",
    "cloth-config": ">=${versions.cloth_config_range}"
  }
}
